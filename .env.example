# Скопируйте в .env: cp .env.example .env
# Поднимите Postgres (порт 5433 — чтобы не конфликтовать с локальным 5432):
#   docker run -d --name paywall-pg \
#     -e POSTGRES_USER=paywall \
#     -e POSTGRES_PASSWORD=paywall \
#     -e POSTGRES_DB=paywall \
#     -p 5433:5432 \
#     postgres:16-alpine
# Затем: npm run db:migrate && npm run dev

DATABASE_URL=postgresql://paywall:paywall@localhost:5433/paywall
